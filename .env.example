# Server
PORT=3001

# Comma-separated browser origins allowed to connect to Socket.IO.
# Leave unset for local/private testing. Example:
# ALLOWED_ORIGINS=https://your-inkchain-app.example.com
ALLOWED_ORIGINS=

# Client
# Leave unset when the client is served by the same production Node app.
# Use this only when the React client and Socket.IO server are hosted separately.
# VITE_SERVER_URL=https://your-inkchain-api.example.com
VITE_SERVER_URL=
